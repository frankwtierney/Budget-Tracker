rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ---- System-level (Super Admin) ----
    // The single doc system/config holds organization-wide settings
    // (building types, period names) and a roles map for Super Admins.
    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/system/config) &&
        get(/databases/$(database)/documents/system/config).data.roles[request.auth.uid] == 'admin';
    }

    // ---- Department roles ----
    function deptRole(deptId) {
      return get(/databases/$(database)/documents/departments/$(deptId)).data.roles[request.auth.uid];
    }
    function isDeptMember(deptId) {
      return isAuth() && deptRole(deptId) in ['admin', 'member', 'viewer'];
    }
    function isDeptEditor(deptId) {
      return isAuth() && deptRole(deptId) in ['admin', 'member'];
    }
    function isDeptAdmin(deptId) {
      return isAuth() && deptRole(deptId) == 'admin';
    }

    // ---- Area roles ----
    function areaRole(areaId) {
      return get(/databases/$(database)/documents/areas/$(areaId)).data.roles[request.auth.uid];
    }
    function areaDept(areaId) {
      return get(/databases/$(database)/documents/areas/$(areaId)).data.departmentId;
    }
    function isAreaMember(areaId) {
      return isAuth() && areaRole(areaId) in ['admin', 'member', 'viewer'];
    }
    function isAreaEditor(areaId) {
      return isAuth() && areaRole(areaId) in ['admin', 'member'];
    }
    function isAreaAdmin(areaId) {
      return isAuth() && areaRole(areaId) == 'admin';
    }
    // Effective area access: own role OR parent dept admin
    function canReadArea(areaId) {
      return isAreaMember(areaId) || isDeptMember(areaDept(areaId));
    }
    function canEditArea(areaId) {
      return isAreaEditor(areaId) || isDeptEditor(areaDept(areaId));
    }
    function canAdminArea(areaId) {
      return isAreaAdmin(areaId) || isDeptAdmin(areaDept(areaId));
    }

    // ---- Building roles ----
    function buildingRole(buildingId) {
      return get(/databases/$(database)/documents/buildings/$(buildingId)).data.roles[request.auth.uid];
    }
    function buildingArea(buildingId) {
      return get(/databases/$(database)/documents/buildings/$(buildingId)).data.areaId;
    }
    function buildingDept(buildingId) {
      return get(/databases/$(database)/documents/buildings/$(buildingId)).data.departmentId;
    }
    function isBuildingMember(buildingId) {
      return isAuth() && buildingRole(buildingId) in ['admin', 'member', 'viewer'];
    }
    function isBuildingEditor(buildingId) {
      return isAuth() && buildingRole(buildingId) in ['admin', 'member'];
    }
    function isBuildingAdmin(buildingId) {
      return isAuth() && buildingRole(buildingId) == 'admin';
    }
    // Effective building access: own role OR parent area/dept role
    function canReadBuilding(buildingId) {
      return isBuildingMember(buildingId) ||
             isAreaMember(buildingArea(buildingId)) ||
             isDeptMember(buildingDept(buildingId));
    }
    function canEditBuilding(buildingId) {
      return isBuildingEditor(buildingId) ||
             isAreaEditor(buildingArea(buildingId)) ||
             isDeptEditor(buildingDept(buildingId));
    }
    function canAdminBuilding(buildingId) {
      return isBuildingAdmin(buildingId) ||
             isAreaAdmin(buildingArea(buildingId)) ||
             isDeptAdmin(buildingDept(buildingId));
    }

    // ---- Users ----
    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // ---- Departments ----
    // Super Admins have global read/update on the structure doc itself (used by
    // the System → Structure editor). Subcollections below are unchanged and
    // still gate on department roles only.
    match /departments/{deptId} {
      allow read: if isSuperAdmin() || isDeptMember(deptId);
      allow create: if isAuth();
      allow update: if isSuperAdmin() || isDeptAdmin(deptId);
      allow delete: if false;

      match /fiscalYears/{fyId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptAdmin(deptId);
      }
      match /categories/{catId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptAdmin(deptId);
      }
      match /strategyTypes/{stId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptAdmin(deptId);
      }
      match /paymentSources/{psId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptAdmin(deptId);
      }
      match /staffMembers/{staffId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptAdmin(deptId);
      }
      match /vendors/{vendorId} {
        allow read: if isDeptMember(deptId);
        allow create, update: if isDeptEditor(deptId);
        allow delete: if false;
      }
      match /events/{eventId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptEditor(deptId);
      }
      match /transactions/{txId} {
        allow read: if isDeptMember(deptId);
        allow create: if isDeptEditor(deptId);
        allow update: if isDeptAdmin(deptId) && resource.data.voidedAt == null;
        allow delete: if false;
      }
      match /reconciliationCycles/{cycleId} {
        allow read: if isDeptMember(deptId);
        allow write: if isDeptAdmin(deptId);
      }
      match /auditLog/{logId} {
        allow read: if isDeptAdmin(deptId);
        allow create: if isDeptEditor(deptId);
        allow update, delete: if false;
      }
    }

    // ---- Areas ----
    // Super Admins can read/create/update the area structure doc globally
    // (System → Structure editor). Area subcollections below are unchanged.
    match /areas/{areaId} {
      allow read: if isSuperAdmin() || canReadArea(areaId);
      allow create: if isAuth() && (isSuperAdmin() || isDeptAdmin(request.resource.data.departmentId));
      allow update: if isSuperAdmin() || canAdminArea(areaId);
      allow delete: if false;

      match /categories/{catId} {
        allow read: if canReadArea(areaId);
        allow write: if canAdminArea(areaId);
      }
      match /staffMembers/{staffId} {
        allow read: if canReadArea(areaId);
        allow write: if canAdminArea(areaId);
      }
      match /vendors/{vendorId} {
        allow read: if canReadArea(areaId);
        allow create, update: if canEditArea(areaId);
        allow delete: if false;
      }
      match /events/{eventId} {
        allow read: if canReadArea(areaId);
        allow write: if canEditArea(areaId);
      }
      match /transactions/{txId} {
        allow read: if canReadArea(areaId);
        allow create: if canEditArea(areaId);
        allow update: if canAdminArea(areaId) && resource.data.voidedAt == null;
        allow delete: if false;
      }
      match /auditLog/{logId} {
        allow read: if canAdminArea(areaId);
        allow create: if canEditArea(areaId);
        allow update, delete: if false;
      }
    }

    // ---- Buildings ----
    // Super Admins can read/create/update the building structure doc globally
    // (System → Structure editor). Building subcollections below are unchanged.
    match /buildings/{buildingId} {
      allow read: if isSuperAdmin() || canReadBuilding(buildingId);
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isDeptAdmin(request.resource.data.departmentId) ||
        isAreaAdmin(request.resource.data.areaId)
      );
      allow update: if isSuperAdmin() || canAdminBuilding(buildingId);
      allow delete: if false;

      match /categories/{catId} {
        allow read: if canReadBuilding(buildingId);
        allow write: if canAdminBuilding(buildingId);
      }
      match /allocations/{fyId} {
        allow read: if canReadBuilding(buildingId);
        allow write: if canAdminBuilding(buildingId);
      }
      match /staffMembers/{staffId} {
        allow read: if canReadBuilding(buildingId);
        allow write: if canAdminBuilding(buildingId);
      }
      match /vendors/{vendorId} {
        allow read: if canReadBuilding(buildingId);
        allow create, update: if canEditBuilding(buildingId);
        allow delete: if false;
      }
      match /events/{eventId} {
        allow read: if canReadBuilding(buildingId);
        allow write: if canEditBuilding(buildingId);
      }
      match /transactions/{txId} {
        allow read: if canReadBuilding(buildingId);
        allow create: if canEditBuilding(buildingId);
        allow update: if canAdminBuilding(buildingId) && resource.data.voidedAt == null;
        allow delete: if false;
      }
      match /reconciliationCycles/{cycleId} {
        allow read: if canReadBuilding(buildingId);
        allow write: if canAdminBuilding(buildingId);
      }
      match /auditLog/{logId} {
        allow read: if canAdminBuilding(buildingId);
        allow create: if canEditBuilding(buildingId);
        allow update, delete: if false;
      }
    }

    // ---- System config ----
    // Bootstrap rule: any authenticated user can CREATE system/config if it
    // doesn't exist yet, but only by writing themselves into roles as 'admin'.
    // After creation, only Super Admins can update.
    match /system/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        docId == 'config' &&
        request.resource.data.roles[request.auth.uid] == 'admin';
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ---- Complexes ----
    // Complexes are operational groupings of buildings within an Area.
    // Read access mirrors Area read access.
    match /complexes/{complexId} {
      allow read: if isAuth() && (
        isAreaMember(resource.data.areaId) ||
        isDeptMember(resource.data.departmentId)
      );
      allow create: if isAuth() && (
        isDeptAdmin(request.resource.data.departmentId) ||
        isAreaAdmin(request.resource.data.areaId)
      );
      allow update: if isAuth() && (
        isAreaAdmin(resource.data.areaId) ||
        isDeptAdmin(resource.data.departmentId)
      );
      allow delete: if false;

      // Complex-level shared staff (visible to area/dept members)
      match /staffMembers/{staffId} {
        allow read: if isAuth() && (
          isAreaMember(get(/databases/$(database)/documents/complexes/$(complexId)).data.areaId) ||
          isDeptMember(get(/databases/$(database)/documents/complexes/$(complexId)).data.departmentId)
        );
        allow write: if isAuth() && (
          isAreaAdmin(get(/databases/$(database)/documents/complexes/$(complexId)).data.areaId) ||
          isDeptAdmin(get(/databases/$(database)/documents/complexes/$(complexId)).data.departmentId)
        );
      }
    }
  }
}
